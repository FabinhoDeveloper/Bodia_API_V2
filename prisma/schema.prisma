// Modelagem do BodIA — construída em etapas, uma revisada por vez.
//
// Base:
//   - Alimento e Exercicio: cópia dos catálogos em memória (src/data/), alvo
//     das chaves estrangeiras das fichas;
//   - Usuario: dados pessoais e físicos, do cadastro e do onboarding;
//   - RegistroPeso: histórico de peso;
//   - Restricao: restrições alimentares e físicas declaradas no onboarding.
//
// Prescrição (o que o plano gerado manda fazer):
//   FichaTreino      → SessaoTreino[]  → ExercicioSessao[] → Exercicio
//   FichaAlimentacao → Refeicao[]      → ItemRefeicao[]    → Alimento
//
// Execução (o que o usuário de fato fez):
//   RegistroHidratacao — água ingerida
//   RegistroRefeicao   — refeição prescrita marcada como consumida
//   RegistroTreino     → RegistroSerie[] — treino executado, série a série
//
// Prescrição e execução são coisas distintas e vivem em tabelas próprias.
//
// Os enums espelham os tipos de src/services/CalculoService.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Catálogos
//
// Populados por prisma/seed.ts a partir de src/data/, preservando os ids. É o
// que permite o id devolvido pela IA virar chave estrangeira sem tradução.
// ---------------------------------------------------------------------------

/// Recorte da Tabela Brasileira de Composição de Alimentos (TACO, NEPA/UNICAMP).
/// O id é o MESMO da TACO — vem de src/data/alimentos.ts, a mesma lista que
/// alimenta o prompt.
model Alimento {
  id          Int    @id
  nome        String
  categoria   String
  /// Valores por 100 g.
  kcal        Float
  proteina    Float
  carboidrato Float
  gordura     Float
  fibra       Float

  itensRefeicao ItemRefeicao[]

  @@index([categoria])
}

/// Catálogo de exercícios (src/data/exercicios.ts).
model Exercicio {
  id            Int      @id
  nome          String
  grupoMuscular String
  /// Sessões em que cabe: Push, Pull, Legs, Upper, Lower, Corpo inteiro.
  sessoes       String[]
  /// Articulações sob carga — é o que permite excluir exercício por lesão.
  articulacoes  String[]

  emSessoes ExercicioSessao[]
  cargas    CargaExercicio[]

  @@index([grupoMuscular])
}

// ---------------------------------------------------------------------------
// Usuário
// ---------------------------------------------------------------------------

/// Dados pessoais (cadastro) e físicos (onboarding) na mesma tabela: são um
/// registro só por pessoa e sempre lidos juntos.
///
/// O PESO NÃO ESTÁ AQUI de propósito — vive em RegistroPeso, e o peso atual é
/// o registro mais recente. Guardar nos dois lugares deixaria as cópias
/// divergirem assim que uma fosse atualizada sem a outra.
model Usuario {
  id        String @id @default(uuid())
  nome      String
  sobrenome String
  email     String @unique
  /// Sempre hash (bcrypt) — nunca a senha em texto.
  senhaHash String

  // Físicos, coletados no onboarding
  sexo              Sexo
  dataNascimento    DateTime
  alturaCm          Float
  percentualGordura Float?
  nivelAtividade    NivelAtividade
  nivelExperiencia  NivelExperiencia
  objetivo          Objetivo
  diasPorSemana     Int
  /// Quantas refeições o usuário faz por dia (3 a 6), escolhido no onboarding.
  /// O default só cobre as linhas gravadas antes da pergunta existir — o código
  /// sempre informa o valor.
  numeroRefeicoes   Int              @default(4)

  /// Quando o usuário aceitou o aviso legal e a política de privacidade (RF36).
  ///
  /// Guarda o INSTANTE, e não um booleano: "aceitou" sem "quando" não serve de
  /// prova nenhuma, e é justamente a data que permite pedir novo aceite se o
  /// texto mudar. Nulo só nas linhas gravadas antes de a pergunta existir — o
  /// cadastro sempre preenche, e recusa o payload sem aceite.
  aceiteTermosEm DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  pesos             RegistroPeso[]
  restricoes        Restricao[]
  fichasTreino      FichaTreino[]
  fichasAlimentacao FichaAlimentacao[]
  hidratacoes       RegistroHidratacao[]
  refeicoesFeitas   RegistroRefeicao[]
  cargas            CargaExercicio[]
  treinosFeitos     RegistroTreino[]
}

/// Restrições declaradas no onboarding (chips "Lactose", "Joelho"... e o campo
/// livre "Outro"). Tabela única para os dois tipos porque o app trata ambos do
/// mesmo jeito: lista de texto.
///
/// São o que faz o gerador do plano excluir alimentos e exercícios — sem isso,
/// um vegano receberia frango.
model Restricao {
  id        String        @id @default(uuid())
  usuarioId String
  tipo      TipoRestricao
  descricao String

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, tipo])
}

/// Histórico de peso. O primeiro registro nasce no cadastro; os seguintes, cada
/// vez que o usuário se pesa. Guardar o histórico (em vez de sobrescrever um
/// campo) é o que permite mostrar a evolução ao longo do tempo.
///
/// Sem restrição de um por dia: pesar-se duas vezes no mesmo dia é legítimo, e
/// o mais recente vence.
model RegistroPeso {
  id           String   @id @default(uuid())
  usuarioId    String
  pesoKg       Float
  registradoEm DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  /// Serve tanto para "peso atual" (mais recente) quanto para o gráfico.
  @@index([usuarioId, registradoEm])
}

// ---------------------------------------------------------------------------
// Prescrição: ficha de treino
//
// FichaTreino → SessaoTreino[] → ExercicioSessao[] → Exercicio (catálogo)
// ---------------------------------------------------------------------------

/// O treino prescrito ao usuário, com os números que o CalculoService produziu.
///
/// Gerar um plano novo NÃO apaga o anterior: cria outra ficha e marca a antiga
/// como inativa. Preserva a evolução das metas e, quando o treino executado for
/// modelado, mantém válida a ficha em que cada treino foi feito.
///
/// ATENÇÃO: "só uma ficha ativa por usuário" não é garantido por constraint —
/// exigiria índice parcial em SQL cru. É responsabilidade do repository
/// desativar a anterior na MESMA transação em que cria a nova.
model FichaTreino {
  id        String   @id @default(uuid())
  usuarioId String
  ativa     Boolean  @default(true)
  criadaEm  DateTime @default(now())

  split                String
  diasPorSemana        Int
  seriesPorGrupoSemana Int

  usuario Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sessoes SessaoTreino[]

  @@index([usuarioId, ativa])
}

/// Um treino da semana ("Upper", "Push"). O grupo muscular exibido no card
/// NÃO é coluna: sai dos exercícios da sessão, para não virar dado que possa
/// contradizer a lista.
model SessaoTreino {
  id                String @id @default(uuid())
  fichaTreinoId     String
  nome              String
  /// Dias em que a sessão acontece ("Segunda", "Quinta"). É apresentação, mas
  /// fica no banco para o app não precisar recalcular a distribuição da semana.
  ///
  /// É LISTA porque uma sessão pode se repetir: Upper num split de 4 dias
  /// acontece 2x. Antes era um dia só, e a segunda ocorrência simplesmente
  /// sumia — quem pedia 4 dias de treino via 2 na tela.
  diasSemana        String[]
  /// Quantas vezes esta sessão se repete na semana.
  frequenciaSemanal Int
  ordem             Int

  fichaTreino FichaTreino       @relation(fields: [fichaTreinoId], references: [id], onDelete: Cascade)
  exercicios  ExercicioSessao[]
  execucoes   RegistroTreino[]

  @@index([fichaTreinoId])
}

/// Um exercício prescrito dentro da sessão — "Supino reto: 3 séries de 8-12".
/// Uma linha por exercício, não por série: as 3 séries têm a mesma prescrição,
/// e repetir a linha 3 vezes não acrescentaria informação.
model ExercicioSessao {
  id               String @id @default(uuid())
  sessaoTreinoId   String
  exercicioId      Int
  /// Quantas séries fazer.
  series           Int
  /// Faixa, não número exato: "8-12".
  repeticoes       String
  descansoSegundos Int    @default(60)
  ordem            Int

  sessaoTreino SessaoTreino @relation(fields: [sessaoTreinoId], references: [id], onDelete: Cascade)
  exercicio    Exercicio    @relation(fields: [exercicioId], references: [id])
  seriesFeitas RegistroSerie[]

  @@index([sessaoTreinoId])
}

// ---------------------------------------------------------------------------
// Prescrição: ficha de alimentação
//
// FichaAlimentacao → Refeicao[] → ItemRefeicao[] → Alimento (catálogo TACO)
// ---------------------------------------------------------------------------

/// A dieta prescrita, com os números do CalculoService. Mesma regra de
/// histórico da FichaTreino: a anterior é desativada, não apagada.
model FichaAlimentacao {
  id        String   @id @default(uuid())
  usuarioId String
  ativa     Boolean  @default(true)
  criadaEm  DateTime @default(now())

  /// Metabolismo que originou as metas (Mifflin-St Jeor × fator de atividade).
  tmb  Int
  tdee Int

  caloriasAlvo Int
  proteinaG    Int
  carboidratoG Int
  gorduraG     Int
  metaAguaMl   Int @default(2000)

  usuario   Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  refeicoes Refeicao[]

  @@index([usuarioId, ativa])
}

model Refeicao {
  id                 String @id @default(uuid())
  fichaAlimentacaoId String
  nome               String
  /// Horário sugerido ("07:30").
  horario            String
  ordem              Int

  /// Metas da refeição — a fatia do dia que cabe a ela.
  kcal         Int
  proteinaG    Int
  carboidratoG Int
  gorduraG     Int

  fichaAlimentacao FichaAlimentacao   @relation(fields: [fichaAlimentacaoId], references: [id], onDelete: Cascade)
  itens            ItemRefeicao[]
  registros        RegistroRefeicao[]

  @@index([fichaAlimentacaoId])
}

/// Um alimento da refeição, em gramas. O valor nutricional NÃO é copiado para
/// cá: vem do catálogo pelo FK, senão a TACO ficaria duplicada e as duas
/// cópias poderiam divergir.
model ItemRefeicao {
  id         String @id @default(uuid())
  refeicaoId String
  alimentoId Int
  gramas     Float

  refeicao Refeicao @relation(fields: [refeicaoId], references: [id], onDelete: Cascade)
  alimento Alimento @relation(fields: [alimentoId], references: [id])

  @@index([refeicaoId])
}

/// A carga que o usuário usou pela última vez em cada exercício do CATÁLOGO.
///
/// Ficava em `ExercicioSessao.ultimoPesoKg`, dentro da ficha — e isso estava
/// errado: a carga é atributo do par (usuário, exercício), não da prescrição.
/// Gerar um plano novo cria outra ficha, e a carga de todos os exercícios
/// voltava a NULL; o usuário perdia o histórico de peso inteiro por ter pedido
/// um plano novo.
///
/// Aqui ela sobrevive à troca de ficha e continua valendo mesmo que o exercício
/// reapareça em outra sessão ou outro split.
///
/// Uma linha por par, sobrescrita a cada treino registrado: não é histórico do
/// que foi levantado, é só o valor que o app pré-preenche ao abrir a série.
model CargaExercicio {
  id           String   @id @default(uuid())
  usuarioId    String
  exercicioId  Int
  pesoKg       Float
  atualizadoEm DateTime @updatedAt

  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  exercicio Exercicio @relation(fields: [exercicioId], references: [id])

  @@unique([usuarioId, exercicioId])
}

// ---------------------------------------------------------------------------
// Execução: o que o usuário registrou ter feito
//
// Distinto da prescrição acima: a ficha diz o que fazer, estas tabelas dizem o
// que foi feito. Nenhuma das duas deriva da outra.
// ---------------------------------------------------------------------------

/// Cada gole registrado — uma linha por toque no app, não um total por dia.
///
/// Guardar o evento (e não um contador acumulado) é o que permite desfazer um
/// registro errado apagando uma linha, em vez de subtrair às cegas de um total
/// que ninguém sabe como foi formado. De quebra preserva a que horas a pessoa
/// bebeu, que um total do dia jogaria fora.
///
/// NÃO existe coluna `dia`: ela seria derivada de registradoEm mais o fuso, e
/// duas cópias do mesmo fato divergem — a mesma razão pela qual o peso atual
/// não é campo em Usuario. O recorte do dia é feito na leitura, por
/// config/fuso.ts, porque o servidor roda em UTC e o usuário não: uma ceia às
/// 22h em Brasília é 01h UTC do dia seguinte, e cortar por dia UTC gravaria a
/// água no dia errado.
model RegistroHidratacao {
  id           String   @id @default(uuid())
  usuarioId    String
  /// Mililitros. Inteiro — não existe meio mililitro de água registrado a dedo.
  volumeMl     Int
  registradoEm DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  /// Serve às duas consultas que existem: o total do dia e o histórico por
  /// período.
  @@index([usuarioId, registradoEm])
}

/// Uma refeição prescrita que o usuário marcou como comida.
///
/// Ao contrário da hidratação, isto NÃO é log acumulativo: existe no máximo um
/// registro por (refeição, dia), e marcar de novo não deve criar outra linha.
///
/// ATENÇÃO: esse "um por dia" NÃO é garantido por constraint. Expressá-lo em
/// SQL exigiria uma coluna `dia` (cópia derivada, recusada aqui pelos mesmos
/// motivos de RegistroHidratacao) ou um índice por expressão, que espalharia o
/// offset do fuso para fora de config/fuso.ts. A garantia é do RefeicaoService,
/// que consulta a janela do dia antes de inserir — mesma natureza da regra
/// "só uma ficha ativa por usuário", que também vive no código.
///
/// Os macros NÃO são copiados para cá: vêm da Refeicao pelo FK, como
/// ItemRefeicao faz com o catálogo. Como a ficha antiga é desativada e nunca
/// apagada, o FK preserva sozinho o que foi comido naquele dia — inclusive
/// depois de o usuário gerar um plano novo.
model RegistroRefeicao {
  id           String   @id @default(uuid())
  usuarioId    String
  refeicaoId   String
  registradoEm DateTime @default(now())

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  refeicao Refeicao @relation(fields: [refeicaoId], references: [id], onDelete: Cascade)

  /// O dia do usuário e o histórico por período.
  @@index([usuarioId, registradoEm])
}

/// Um treino executado: a sessão prescrita que o usuário de fato fez.
///
/// Aponta para a SessaoTreino da ficha, e não para a ficha ativa do momento da
/// leitura. Como a ficha antiga é desativada e nunca apagada, o histórico
/// continua dizendo qual treino foi feito mesmo depois de o usuário gerar um
/// plano novo — mesma mecânica de RegistroRefeicao.
///
/// `concluidoEm` nulo significa treino ABERTO (em andamento). Sessão abandonada
/// fica assim para sempre, e é o que separa "fiz" de "comecei": as consultas
/// filtram por `concluidoEm` não-nulo.
model RegistroTreino {
  id             String    @id @default(uuid())
  usuarioId      String
  sessaoTreinoId String
  iniciadoEm     DateTime  @default(now())
  concluidoEm    DateTime?

  usuario      Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sessaoTreino SessaoTreino @relation(fields: [sessaoTreinoId], references: [id], onDelete: Cascade)
  series       RegistroSerie[]

  /// A semana do usuário (cards de treino) e o histórico por período.
  @@index([usuarioId, iniciadoEm])
}

/// Uma série executada: o peso e as repetições daquela série específica.
///
/// UMA LINHA POR SÉRIE, ao contrário de ExercicioSessao, que é uma linha por
/// exercício. A diferença não é inconsistência: na PRESCRIÇÃO as três séries
/// são idênticas ("3x8-12"), e repetir a linha não acrescentaria informação; na
/// EXECUÇÃO elas divergem — a carga cai na terceira série, as repetições não
/// fecham —, e é justamente essa variação que o usuário registra.
///
/// Não há tabela intermediária de "exercício executado": ela não carregaria
/// nenhum dado próprio, só o mesmo `exercicioSessaoId` que já está aqui.
model RegistroSerie {
  id                String @id @default(uuid())
  registroTreinoId  String
  /// FK para o exercício PRESCRITO — é por ele que se chega ao nome, ao grupo
  /// muscular e ao exercício do catálogo, sem copiar nada.
  exercicioSessaoId String
  /// Qual série do exercício, começando em 0. É o que preserva a ordem em que
  /// as cargas caíram.
  ordem             Int
  repeticoes        Int
  /// Nulo em exercício de peso corporal, onde não há carga a informar.
  pesoKg            Float?

  registroTreino  RegistroTreino  @relation(fields: [registroTreinoId], references: [id], onDelete: Cascade)
  exercicioSessao ExercicioSessao @relation(fields: [exercicioSessaoId], references: [id], onDelete: Cascade)

  @@index([registroTreinoId])
}

// ---------------------------------------------------------------------------
// Enums — espelham os tipos de CalculoService.ts
// ---------------------------------------------------------------------------

enum Sexo {
  M
  F
}

enum NivelAtividade {
  SEDENTARIO
  LEVE
  MODERADO
  INTENSO
  ATLETA
}

enum NivelExperiencia {
  INICIANTE
  INTERMEDIARIO
  AVANCADO
}

enum Objetivo {
  PERDER
  MANTER
  GANHAR
}

enum TipoRestricao {
  ALIMENTAR
  FISICA
}
