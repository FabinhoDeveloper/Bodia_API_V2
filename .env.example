DATABASE_URL="postgresql://bodia:bodia@localhost:5432/bodia_app?schema=public"
PORT=3333
JWT_SECRET="change-me-in-production"

# Commit publicado, exibido pela rota `/`. Em producao quem define e o
# scripts/deploy.sh; em dev fica ausente e a rota mostra "desconhecido".
# GIT_COMMIT=""

# https://platform.openai.com/api-keys
IA_API_KEY=""
IA_MODEL="gpt-4o-mini"

# Vazio = OpenAI (o SDK usa o proprio padrao). Preencher SO para apontar a um
# provider compativel com a interface Chat Completions, por exemplo:
#   https://api.deepseek.com
#   https://generativelanguage.googleapis.com/v1beta/openai/
# CUIDADO: e esta variavel que decide para onde a sua chave e enviada.
IA_BASE_URL=""

# Enquanto true, o backend devolve um plano fixo (src/data/plano-simulado.ts) em
# vez de chamar a IA. Serve para desenvolver o resto sem depender de rede nem de
# credito.
SIMULAR_IA="true"
