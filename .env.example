DATABASE_URL="postgresql://bodia:bodia@localhost:5432/bodia_app?schema=public"
PORT=3333
# Segredo que assina o token de sessao. Em producao, gere um valor longo e
# aleatorio (`openssl rand -base64 48`) e NAO reutilize o do exemplo: quem
# souber o segredo assina um token de qualquer usuario.
JWT_SECRET="change-me-in-production"
# Prazo do token. Passado ele, o app recebe 401 e volta para a tela de login.
JWT_EXPIRES_IN="7d"

# Commit publicado, exibido pela rota `/`. Em producao quem define e o
# scripts/deploy.sh; em dev fica ausente e a rota mostra "desconhecido".
# GIT_COMMIT=""

# https://platform.openai.com/api-keys
IA_API_KEY=""
IA_MODEL="gpt-4o-mini"

# Vazio = OpenAI (o SDK usa o proprio padrao). Preencher SO para apontar a um
# provider compativel com a interface Chat Completions, por exemplo:
#   https://api.deepseek.com
#   https://generativelanguage.googleapis.com/v1beta/openai/
# CUIDADO: e esta variavel que decide para onde a sua chave e enviada.
IA_BASE_URL=""

# Enquanto true, o backend devolve um plano fixo (src/data/plano-simulado.ts) em
# vez de chamar a IA. Serve para desenvolver o resto sem depender de rede nem de
# credito.
SIMULAR_IA="true"

# --- E-mail (redefinicao de senha, RF03) ------------------------------------
# SMTP do Gmail, com a conta do projeto. SMTP_PASS e uma SENHA DE APP, nunca a
# senha da conta: gere em myaccount.google.com/apppasswords (exige verificacao
# em duas etapas) e cole os 16 caracteres SEM os espacos que o Google mostra.
# Porta 587 (STARTTLS): na EC2 a porta 25 tem limite de envio. Limite do Gmail:
# ~500 e-mails por dia.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="conta-do-projeto@gmail.com"
SMTP_PASS=""
# No Gmail, o remetente precisa ser a propria conta do SMTP_USER.
EMAIL_REMETENTE="BodIA <conta-do-projeto@gmail.com>"
# Endereco publico do backend, sem barra no fim: base do link do e-mail
# (<URL_PUBLICA>/redefinir-senha#token=...). Obrigatorio para o envio real.
URL_PUBLICA="https://bodia.duckdns.org"
# true = o e-mail nao sai, o conteudo (com o link) vai para o log. So para dev:
# em producao o link no log e acesso a conta de alguem. Padrao: false.
SIMULAR_EMAIL="false"
