DATABASE_URL="postgresql://bodia:bodia@localhost:5432/bodia_app?schema=public"
PORT=3333
JWT_SECRET="change-me-in-production"

# Gere a chave em https://platform.deepseek.com
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-v4-pro"

# Enquanto true, o backend devolve um plano fixo (src/data/planoSimulado.ts) em
# vez de chamar a IA. Serve para desenvolver o resto sem depender de uma chamada
# que hoje leva ~3 min e falha com frequencia.
SIMULAR_IA="true"
